        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-9" value="&lt;strong data-end=&quot;790&quot; data-start=&quot;743&quot;&gt;Simple binary classification, interpretable&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;819&quot; data-start=&quot;798&quot;&gt;Logistic Regression&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-10" value="&lt;strong data-end=&quot;858&quot; data-start=&quot;822&quot;&gt;Nonlinear or interaction effects&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;881&quot; data-start=&quot;866&quot;&gt;Decision Tree&lt;/code&gt;, &lt;code data-end=&quot;898&quot; data-start=&quot;883&quot;&gt;Random Forest&lt;/code&gt;, &lt;code data-end=&quot;919&quot; data-start=&quot;900&quot;&gt;Gradient Boosting&lt;/code&gt;, &lt;code data-end=&quot;926&quot; data-start=&quot;921&quot;&gt;SVM&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-11" value="&lt;strong data-end=&quot;972&quot; data-start=&quot;929&quot;&gt;Small dataset, simple decision boundary&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;985&quot; data-start=&quot;980&quot;&gt;KNN&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="560" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-12" value="&lt;strong data-end=&quot;1034&quot; data-start=&quot;988&quot;&gt;High-dimensional data (e.g., text, images)&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1047&quot; data-start=&quot;1042&quot;&gt;SVM&lt;/code&gt;, &lt;code data-end=&quot;1066&quot; data-start=&quot;1049&quot;&gt;Neural Networks&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="400" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-13" value="&lt;strong data-end=&quot;1105&quot; data-start=&quot;1069&quot;&gt;Unbalanced classes (rare events)&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1122&quot; data-start=&quot;1113&quot;&gt;XGBoost&lt;/code&gt;, &lt;code data-end=&quot;1158&quot; data-start=&quot;1124&quot;&gt;Logistic Regression + resampling&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="480" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-14" value="&lt;strong data-end=&quot;1261&quot; data-start=&quot;1213&quot;&gt;Spherical clusters, known number of clusters&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1278&quot; data-start=&quot;1269&quot;&gt;K-Means&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="680" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-15" value="&lt;strong data-end=&quot;1329&quot; data-start=&quot;1281&quot;&gt;Unknown number of clusters, irregular shapes&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1345&quot; data-start=&quot;1337&quot;&gt;DBSCAN&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="760" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-16" value="&lt;strong data-end=&quot;1393&quot; data-start=&quot;1348&quot;&gt;Hierarchical relationships or dendrograms&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1426&quot; data-start=&quot;1401&quot;&gt;Hierarchical Clustering&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="680" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-17" value="&lt;strong data-end=&quot;1512&quot; data-start=&quot;1492&quot;&gt;Linear structure&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1525&quot; data-start=&quot;1520&quot;&gt;PCA&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="880" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-18" value="&lt;strong data-end=&quot;1551&quot; data-start=&quot;1528&quot;&gt;Nonlinear structure&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1566&quot; data-start=&quot;1559&quot;&gt;t-SNE&lt;/code&gt;, &lt;code data-end=&quot;1574&quot; data-start=&quot;1568&quot;&gt;UMAP&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="960" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-19" value="&lt;strong data-end=&quot;1603&quot; data-start=&quot;1577&quot;&gt;Deep learning features&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;1625&quot; data-start=&quot;1611&quot;&gt;Autoencoders&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
