        <mxCell id="_zRDfOtlAG3t_aV2EUTi-38" value="&lt;h2 style=&quot;box-sizing: inherit; margin: var(--devsite-h2-margin); overflow-x: clip; text-overflow: ellipsis; border-bottom: var(--devsite-h2-border,var(--devsite-secondary-border)); padding: var(--devsite-h2-padding); color: rgb(32, 33, 36); text-align: start; background-color: rgb(255, 255, 255);&quot; role=&quot;presentation&quot; tabindex=&quot;-1&quot; id=&quot;regularization&quot; data-text=&quot;正则化&quot;&gt;&lt;span style=&quot;box-sizing: inherit;&quot; aria-level=&quot;2&quot; role=&quot;heading&quot; class=&quot;devsite-heading&quot;&gt;正则化&lt;/span&gt;&lt;/h2&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="1650" width="120" height="60" as="geometry" />
        </mxCell>
