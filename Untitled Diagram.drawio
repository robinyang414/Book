          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_zRDfOtlAG3t_aV2EUTi-30" value="&lt;h2 style=&quot;box-sizing: inherit; margin: var(--devsite-h2-margin); overflow-x: clip; text-overflow: ellipsis; border-bottom: var(--devsite-h2-border,var(--devsite-secondary-border)); padding: var(--devsite-h2-padding); color: rgb(32, 33, 36); background-color: rgb(255, 255, 255);&quot; role=&quot;presentation&quot; tabindex=&quot;-1&quot; id=&quot;what_causes_overfitting&quot; data-text=&quot;什么会导致过拟合？&quot;&gt;&lt;span style=&quot;box-sizing: inherit;&quot; aria-level=&quot;2&quot; role=&quot;heading&quot; class=&quot;devsite-heading&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;什么会导致过拟合？&lt;/font&gt;&lt;/span&gt;&lt;/h2&gt;&lt;div&gt;&lt;span style=&quot;box-sizing: inherit;&quot; aria-level=&quot;2&quot; role=&quot;heading&quot; class=&quot;devsite-heading&quot;&gt;&lt;span style=&quot;color: rgb(32, 33, 36); font-family: Roboto, &amp;quot;Noto Sans&amp;quot;, &amp;quot;Noto Sans JP&amp;quot;, &amp;quot;Noto Sans KR&amp;quot;, &amp;quot;Noto Naskh Arabic&amp;quot;, &amp;quot;Noto Sans Thai&amp;quot;, &amp;quot;Noto Sans Hebrew&amp;quot;, &amp;quot;Noto Sans Bengali&amp;quot;, sans-serif; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;训练集不能充分代表真实数据；&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(32, 33, 36); font-family: Roboto, &amp;quot;Noto Sans&amp;quot;, &amp;quot;Noto Sans JP&amp;quot;, &amp;quot;Noto Sans KR&amp;quot;, &amp;quot;Noto Naskh Arabic&amp;quot;, &amp;quot;Noto Sans Thai&amp;quot;, &amp;quot;Noto Sans Hebrew&amp;quot;, &amp;quot;Noto Sans Bengali&amp;quot;, sans-serif;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;模型过于复杂。&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="230" y="1520" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_zRDfOtlAG3t_aV2EUTi-31" value="&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;泛化条件：&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font size=&quot;3&quot; style=&quot;&quot; face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;color: rgb(32, 33, 36); background-color: rgb(255, 255, 255);&quot;&gt;示例必须&lt;/span&gt;&lt;a style=&quot;box-sizing: inherit; outline: 0px; text-decoration: var(--devsite-link-text-decoration,none); word-break: break-word; background-color: rgb(255, 255, 255);&quot; href=&quot;https://developers.google.com/machine-learning/glossary?hl=zh-cn#independently-and-identically-distributed-i.i.d&quot;&gt;&lt;span style=&quot;box-sizing: inherit;&quot;&gt;独立且等概率分布&lt;/span&gt;&lt;/a&gt;；&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; style=&quot;&quot; face=&quot;Helvetica&quot;&gt;数据集是平稳的，不会发生显著变化；&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font size=&quot;3&quot; style=&quot;&quot; face=&quot;Helvetica&quot;&gt;数据集分区具有相同的分布&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1" parent="1">
