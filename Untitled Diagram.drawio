        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-7" value="&lt;strong data-end=&quot;509&quot; data-start=&quot;476&quot;&gt;Nonlinear or complex patterns&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;532&quot; data-start=&quot;517&quot;&gt;Decision Tree&lt;/code&gt;, &lt;code data-end=&quot;549&quot; data-start=&quot;534&quot;&gt;Random Forest&lt;/code&gt;, &lt;code data-end=&quot;570&quot; data-start=&quot;551&quot;&gt;Gradient Boosting&lt;/code&gt;, &lt;code data-end=&quot;577&quot; data-start=&quot;572&quot;&gt;SVR&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
