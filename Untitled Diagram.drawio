        </mxCell>
        <mxCell id="hm73lvq_0gJpktWqqyML-8" value="&lt;strong data-end=&quot;621&quot; data-start=&quot;580&quot;&gt;High-dimensional data (many features)&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;647&quot; data-start=&quot;629&quot;&gt;Lasso Regression&lt;/code&gt;, &lt;code data-end=&quot;667&quot; data-start=&quot;649&quot;&gt;Ridge Regression&lt;/code&gt;, &lt;code data-end=&quot;674&quot; data-start=&quot;669&quot;&gt;SVR&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
