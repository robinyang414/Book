        <mxCell id="VabaTQ-oLK2Y-c0kKiKm-32" value="&lt;div&gt;1. &lt;b&gt;Precision&lt;/b&gt; = TP / (TP + FP)&lt;/div&gt;&lt;div&gt;2. Recall (Sensitivity) = TP / (TP + FN)&lt;/div&gt;&lt;div&gt;3. &lt;b&gt;F1 Score&lt;/b&gt; = Harmonic mean of Precision and Recall.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontSize=15;spacingLeft=4;" vertex="1" parent="1">
