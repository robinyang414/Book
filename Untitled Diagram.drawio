        <mxCell id="hm73lvq_0gJpktWqqyML-6" value="&lt;strong data-end=&quot;446&quot; data-start=&quot;401&quot;&gt;Small to medium data, linear relationship&lt;/strong&gt;:&lt;br&gt;→ &lt;code data-end=&quot;473&quot; data-start=&quot;454&quot;&gt;Linear Regression&lt;/code&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
